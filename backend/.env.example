# ---------------------------------------------------------------
# Copy this file to ".env" in the backend/ folder and fill it in.
# ---------------------------------------------------------------

# Which LLM provider to use for answer generation & claim verification.
# Any OpenAI-API-compatible provider works. Pick ONE:
#
#  1) Groq (recommended - has a generous FREE tier, no credit card needed)
#     Get a free key at: https://console.groq.com/keys
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-20b
#
#  2) OpenAI (pay-as-you-go)
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini
#
#  3) Local Ollama (100% free, runs on your machine, no API key needed)
#     Install Ollama, run `ollama pull llama3.1`, then `ollama serve`
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1
#     LLM_API_KEY=ollama   (any non-empty string works)

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your_api_key_here

# Retrieval settings
CHUNK_SIZE=1000
TOP_K=5

# LLM output length (increase for longer/detailed answers)
LLM_ANSWER_MAX_TOKENS=2000

# Optional LLM client settings
LLM_MAX_TOKENS=1200
LLM_VERIFY_MAX_TOKENS=600
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TIMEOUT=45
LLM_MIN_REQUEST_INTERVAL=2.1
LLM_RATE_LIMIT_RETRIES=4

# Optional verification and retrieval limits
EVIDENCE_CHAR_BUDGET=6000
